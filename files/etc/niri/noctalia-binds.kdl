binds {
    Mod+Slash { show-hotkey-overlay; }
    Mod+T hotkey-overlay-title="Open a Terminal: Alacritty" { spawn "alacritty"; }
    Mod+B hotkey-overlay-title="Open the Browser: Firefox" { spawn "firefox"; }
    Mod+E hotkey-overlay-title="Open Files: Nautilus" { spawn "nautilus" "--new-window"; }
    Mod+D hotkey-overlay-title="Run an Application" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Super+Alt+L hotkey-overlay-title="Lock the Screen" { spawn "noctalia" "msg" "session" "lock"; }
    Mod+Shift+E hotkey-overlay-title="Session Menu" { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Mod+Space hotkey-overlay-title="Run an Application" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+S hotkey-overlay-title="Control Center" { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+Shift+Comma hotkey-overlay-title="Noctalia Settings" { spawn "noctalia" "msg" "settings-toggle"; }
    Alt+Tab hotkey-overlay-title="Switch Windows" { spawn "noctalia" "msg" "window-switcher" "hold"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute        allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "noctalia" "msg" "mic-mute"; }

    XF86AudioPlay allow-when-locked=true { spawn "noctalia" "msg" "media" "toggle"; }
    XF86AudioStop allow-when-locked=true { spawn "noctalia" "msg" "media" "stop"; }
    XF86AudioPrev allow-when-locked=true { spawn "noctalia" "msg" "media" "previous"; }
    XF86AudioNext allow-when-locked=true { spawn "noctalia" "msg" "media" "next"; }

    XF86MonBrightnessUp   allow-when-locked=true { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "noctalia" "msg" "brightness-down"; }

    Print hotkey-overlay-title="Screenshot a Region" { spawn "noctalia" "msg" "screenshot-region"; }
    Mod+Shift+S hotkey-overlay-title="Screenshot a Region" { spawn "noctalia" "msg" "screenshot-region"; }
    Ctrl+Print hotkey-overlay-title="Screenshot the Screen" { spawn "noctalia" "msg" "screenshot-fullscreen"; }
    Alt+Print hotkey-overlay-title="Screenshot a Window" { spawn "noctalia" "msg" "screenshot-window"; }
}
