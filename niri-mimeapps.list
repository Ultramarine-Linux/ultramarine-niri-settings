[Default Applications]
inode/directory=org.gnome.Nautilus.desktop

# text
text/plain=org.gnome.TextEditor.desktop
text/x-cmake=org.gnome.TextEditor.desktop
text/markdown=org.gnome.TextEditor.desktop
application/json=org.gnome.TextEditor.desktop
application/x-yaml=org.gnome.TextEditor.desktop
application/x-docbook+xml=org.gnome.TextEditor.desktop
text/x-log=org.gnome.TextEditor.desktop
text/x-python=org.gnome.TextEditor.desktop
text/x-shellscript=org.gnome.TextEditor.desktop
text/x-csrc=org.gnome.TextEditor.desktop
text/x-chdr=org.gnome.TextEditor.desktop
application/toml=org.gnome.TextEditor.desktop
application/xml=org.gnome.TextEditor.desktop
text/css=org.gnome.TextEditor.desktop

# images: use firefox and noctalia annotator as backup
image/png=org.gnome.Loupe.desktop;org.mozilla.firefox.desktop;dev.noctalia.Noctalia.Annotator.desktop;
image/jpeg=org.gnome.Loupe.desktop;org.mozilla.firefox.desktop;dev.noctalia.Noctalia.Annotator.desktop;
image/webp=org.gnome.Loupe.desktop;org.mozilla.firefox.desktop;dev.noctalia.Noctalia.Annotator.desktop;
image/gif=org.gnome.Loupe.desktop;org.mozilla.firefox.desktop;dev.noctalia.Noctalia.Annotator.desktop;
image/avif=org.gnome.Loupe.desktop;org.mozilla.firefox.desktop;
image/bmp=org.gnome.Loupe.desktop;org.mozilla.firefox.desktop;dev.noctalia.Noctalia.Annotator.desktop;
image/svg+xml=org.gnome.Loupe.desktop;org.mozilla.firefox.desktop;dev.noctalia.Noctalia.Annotator.desktop;
image/vnd.microsoft.icon=org.gnome.Loupe.desktop;org.mozilla.firefox.desktop;dev.noctalia.Noctalia.Annotator.desktop;
image/jxl=org.gnome.Loupe.desktop;dev.noctalia.Noctalia.Annotator.desktop;
image/heif=org.gnome.Loupe.desktop;
image/tiff=org.gnome.Loupe.desktop;

# video, use firefox as backup
video/mp4=org.gnome.Showtime.desktop;org.mozilla.firefox.desktop;
video/x-m4v=org.gnome.Showtime.desktop;org.mozilla.firefox.desktop;
video/webm=org.gnome.Showtime.desktop;org.mozilla.firefox.desktop;
video/ogg=org.gnome.Showtime.desktop;org.mozilla.firefox.desktop;
video/x-ogm+ogg=org.gnome.Showtime.desktop;org.mozilla.firefox.desktop;
video/x-theora+ogg=org.gnome.Showtime.desktop;org.mozilla.firefox.desktop;
video/x-matroska=org.gnome.Showtime.desktop;
video/quicktime=org.gnome.Showtime.desktop;
video/vnd.avi=org.gnome.Showtime.desktop;

# mail and calendar
x-scheme-handler/mailto=net.thunderbird.Thunderbird.desktop;
message/rfc822=net.thunderbird.Thunderbird.desktop;
text/calendar=net.thunderbird.Thunderbird.desktop;

# firefox: browser, pdf, audio
x-scheme-handler/http=org.mozilla.firefox.desktop
x-scheme-handler/https=org.mozilla.firefox.desktop
text/html=org.mozilla.firefox.desktop
application/xhtml+xml=org.mozilla.firefox.desktop
application/pdf=org.mozilla.firefox.desktop
audio/aac=org.mozilla.firefox.desktop
audio/mp4=org.mozilla.firefox.desktop
audio/mpeg=org.mozilla.firefox.desktop
audio/ogg=org.mozilla.firefox.desktop
audio/x-vorbis+ogg=org.mozilla.firefox.desktop
audio/flac=org.mozilla.firefox.desktop
audio/x-flac+ogg=org.mozilla.firefox.desktop
audio/x-opus+ogg=org.mozilla.firefox.desktop
audio/vnd.wave=org.mozilla.firefox.desktop

# network locations
x-scheme-handler/smb=org.gnome.Nautilus.desktop
x-scheme-handler/sftp=org.gnome.Nautilus.desktop
